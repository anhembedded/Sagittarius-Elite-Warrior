@startuml hld-03_workbench_places
title HLD-03 — The workbench: places a module may contribute to (§4.6)\nThe shell owns the vocabulary; a module chooses places, never invents layout
skinparam rectangleBorderThickness 1

rectangle "Shell window" as Win {
  rectangle "Sidebar\n(derived from `screen` contributions —\nnobody contributes here directly)" as Side #LightGray
  rectangle "Surface = PageShell (one per screen)" as Page {
    rectangle "header\n(page-wide actions · status_tile)" as H #LightYellow
    rectangle "context_bar\n(current symbol / connection)" as CB #LightYellow
    rectangle "workspace\n(the ONE big thing: chart, table, form)\nonly market_data / charting contribute" as WS #LightGreen
    rectangle "rail\n(column of cards, ordered by `order`;\nsize_hint compact | regular | tall)" as R #LightGreen
    rectangle "console\n(log / diagnostics)" as C #LightYellow
  }
  rectangle "modal (overlay host)\nopened and closed by the page" as M #LightGray
}

rectangle "Surfaces (instances)" as S {
  rectangle "welcome  (default route, shell-owned)\nStart · Developer-mode switch · Restart" as SW
  rectangle "trading  (shell-owned surface)" as STr
  rectangle "dev_board  (only when dev.mode at boot)\n+ probes slot" as SD
  rectangle "settings  (sections slot)" as SS
  rectangle "backtest  (module-owned screen,\naccepts=rail, modal)" as SB
  rectangle "data_management  (module-owned screen)" as SDM
}

rectangle "Module contributions (declared once in module.contribute())" as Contr {
  rectangle "trading → trading.rail + dev_board.rail:\npositions · open orders · session\ndev_board.rail only: manual order (D15)\ndev_board.probes: exchange API tester\nsettings.section · status_tile (ws pill)" as CT
  rectangle "strategy → trading.rail + dev_board.rail:\nstrategy card · last signal\nbacktest.modal: parameters dialog" as CS
  rectangle "market_data → *.workspace feed · context_bar\ndev_board.system_controls\nsettings.section · status_tile (ticker)" as CM
  rectangle "indicators → dev_board.rail: script checklist" as CI
}

CT ..> STr
CT ..> SD
CT ..> SS
CS ..> STr
CS ..> SD
CS ..> SB
CM ..> STr
CM ..> SD
CM ..> SS
CI ..> SD
Side -[hidden]right- Page
Page -[hidden]down- S
S -[hidden]down- Contr
@enduml
