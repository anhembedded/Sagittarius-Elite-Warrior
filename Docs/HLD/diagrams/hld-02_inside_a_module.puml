@startuml hld-02_inside_a_module
title HLD-02 — Inside one module: Clean Architecture, one directory per layer\nArrows = allowed imports; anything not drawn is forbidden by the guards
skinparam packageStyle rectangle

package "modules/<module_id>/" {
  package "contracts/  <<PUBLIC — the only importable surface>>" #LightGreen {
    [i_*.py — ports (ABC named I*)] as Ports
    [dto/ — frozen dataclasses] as DTO
    [events/ — BaseEvent subclasses] as Ev
  }
  package "domain/" #White {
    [entities · value objects · policies\nNO PySide6, NO engine except the 2 Shared-Kernel symbols] as Dom
  }
  package "application/" #White {
    [use cases (command/query handlers)\nservices · feed normalisers\nimplements this module's ports] as App
  }
  package "adapters/" #White {
    [exchange · persistence · engine adapters\nimplements ports with I/O] as Ad
  }
  package "ui/" #White {
    [presenters · view models · coordinators\nwidgets/ (Python wrappers) · cli/ · dev_probes/] as UI
  }
  [module.py\nBoundedContextModule subclass\nregister() · boot() · contribute() · subscribe()] as Mod
}

package "outside" #LightGray {
  [core/vo · core/contracts] as Core
  [other module's contracts/] as OtherC
  [support/*/contracts  +  support/ui_kit, support/charting (ui only)] as Sup
  [src/presentation/ui/qml/<Widget>/*.qml  (stays here — ADR D6)] as Qml
}

App --> Dom
App --> Ports
App --> DTO
App --> Ev
App --> OtherC
App --> Core
Ad --> App
Ad --> Sup
UI --> App
UI --> Sup
UI ..> Qml : QuickSurface loads
Dom --> Core
Mod --> UI
Mod --> Ad
Mod --> App
Mod --> Dom

note right of UI
  ui never imports adapters.
  Today's two violations
  (backtest_presenter.py:43,
  settings_presenter.py:21)
  are fixed when those modules migrate.
end note
@enduml
