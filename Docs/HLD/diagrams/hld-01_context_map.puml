@startuml hld-01_context_map
title HLD-01 — Context map: bounded contexts, support packages, kernel\nArrow = allowed dependency (A --> B: A imports modules/B/contracts only)
skinparam componentStyle rectangle
skinparam wrapWidth 200
left to right direction

package "shell/  (Martin's Main — the only place that knows every module)" #LightGray {
  [modules.py\nexplicit, topologically ordered list] as ModList
  [surfaces/\nwelcome · trading · dev_board · settings] as Surfaces
  [cli/\nparser assembled from cli_command contributions] as Cli
}

package "modules/  (bounded contexts)" {
  [market_data\n<<Supporting · Open Host Service>>] as MD #LightGreen
  [strategy\n<<CORE>>] as ST #Gold
  [trading\n<<Supporting · Supplier of strategy>>] as TR #LightGreen
  [backtesting\n<<Supporting · Customer of market_data + strategy>>] as BT #LightGreen
}

package "support/  (Generic — no business language)" {
  [binance_gateway\nthe ONLY constructor of binance.client.Client] as GW
  [charting\nIChartHost · ChartCard (QtWidgets forever)] as CH
  [indicators\nIIndicatorCatalog] as IND
  [ui_kit\nPageShell · kit · tokens] as KIT
}

package "core/  (app kernel policy)" #LightGray {
  [contracts/\nBoundedContextModule · IContributionRegistry\nICommandDispatcher · IEventPublisher] as CoreC
  [vo/  (Published Language)\nTimeFrame · OrderSide · MarketData · venues …] as CoreV
}

package "Sagittarius Engine  (mechanism — knows no app)" #WhiteSmoke {
  [IExtension · ExtensionManager\nIContainer · IEventBus · QtEventBridge\nIDispatcher · Scheduler · PresenterManager] as Eng
}

ST --> MD : IHistoricalKlines\nMarketTickEvent
ST --> TR : IOrderSubmission\nITradingSession.claim_symbol\nIAccountSnapshot
BT --> MD : IHistoricalKlines · IMarketDataSync\nIRangeCoverage
BT --> ST : IStrategyCatalog\nIStrategyEngineFactory · StrategyContext
TR --> MD : IHistoricalKlines · IMarketStream\nIMarketDataSync (chart)

MD --> GW
TR --> GW
TR ..> CH
ST ..> CH
ST ..> IND
BT ..> CH
BT ..> IND

MD --> CoreC
TR --> CoreC
ST --> CoreC
BT --> CoreC
MD --> CoreV
TR --> CoreV
ST --> CoreV
BT --> CoreV
CoreC ..> Eng : BoundedContextModule\nextends IExtension

ModList --> Eng : app.use(module)
Surfaces ..> CoreC : IContributionRegistry
MD ..> Surfaces : contributes widgets
TR ..> Surfaces
ST ..> Surfaces
MD ..> Cli
TR ..> Cli
ST ..> Cli

note bottom of TR
  trading never imports strategy.
  The cycle is broken by a trading-owned
  concept: the symbol lease.
end note
@enduml
